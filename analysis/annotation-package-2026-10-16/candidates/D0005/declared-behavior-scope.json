{
  "domain_id": "bounded-unary-v1",
  "family": "atan",
  "description": "For inputs in the registered domain, preserve the elementwise mathematical atan value, input shape and floating dtype.",
  "clauses": [
    "value",
    "shape",
    "dtype"
  ],
  "registered_domain": {
    "dtypes": [
      "float32",
      "float64"
    ],
    "rank_max": 4,
    "elements_max": 4096,
    "finite": true,
    "closed_interval": [
      -8.0,
      8.0
    ]
  },
  "atol": 1e-07,
  "rtol": 1e-05,
  "tolerance_by_dtype": {
    "float32": {
      "atol": 1e-07,
      "rtol": 1e-05
    },
    "float64": {
      "atol": 1e-12,
      "rtol": 1e-12
    }
  }
}
