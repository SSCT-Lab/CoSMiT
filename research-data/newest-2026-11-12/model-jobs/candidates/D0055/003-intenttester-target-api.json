ound_truth_backend} returned a {ret_from_gt_dtype} datatype while the backend {backend} returned a {ret_dtype} datatype'\\n    if ret_np.dtype == 'bfloat16' or ret_from_gt_np.dtype == 'bfloat16':\\n        ret_np = ret_np.astype('float64')\\n        ret_from_gt_np = ret_from_gt_np.astype('float64')\\n    assert np.allclose(np.nan_to_num(ret_np), np.nan_to_num(ret_from_gt_np), rtol=rtol, atol=atol), f' the results from backend {backend} and ground truth framework {ground_truth_backend} do not match\\\\n {ret_np}!={ret_from_gt_np} \\\\n\\\\nThe mismatching elements are at `False` indices:\\\\n\\\\n{ret_np == ret_from_gt_np} \\\\n\\\\n'\\n\\ndef assert_same_type_and_shape(values, this_key_chain=None):\\n    x_, y_ = values\\n    for x, y in zip(x_, y_):\\n        if isinstance(x, np.ndarray):\\n            x_d = str(x.dtype).replace('longlong', 'int64')\\n            y_d = str(y.dtype).replace('longlong', 'int64')\\n            assert x.shape == y.shape, f'returned shape = {x.shape}, ground-truth returned shape = {y.shape}'\\n            assert x_d == y_d, f'returned dtype = {x_d}, ground-truth returned dtype = {y_d}'\\n\\ndef value_test(*, ret_np_flat, ret_np_from_gt_flat, rtol=None, atol=1e-06, specific_tolerance_dict=None, backend: str, ground_truth_backend='TensorFlow', test_dtypes=True):\\n    if test_dtypes:\\n        assert_same_type_and_shape([ret_np_flat, ret_np_from_gt_flat])\\n    if type(ret_np_flat) != list:\\n        ret_np_flat = [ret_np_flat]\\n    if type(ret_np_from_gt_flat) != list:\\n        ret_np_from_gt_flat = [ret_np_from_gt_flat]\\n    assert len(ret_np_flat) == len(ret_np_from_gt_flat), f'The length of results from backend {backend} and ground truth framework {ground_truth_backend} does not match\\\\n\\\\nlen(ret_np_flat) != len(ret_np_from_gt_flat):\\\\n\\\\nret_np_flat:\\\\n\\\\n{ret_np_flat}\\\\n\\\\nret_np_from_gt_flat:\\\\n\\\\n{ret_np_from_gt_flat}'\\n    if specific_tolerance_dict is not None:\\n        for ret_np, ret_np_from_gt in zip