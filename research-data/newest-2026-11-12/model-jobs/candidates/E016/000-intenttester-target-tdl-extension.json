 These tests replay their\\ncaptured inputs and output oracle; they do not replay every frontend test flag.\\n\\\"\\\"\\\"\\nimport json\\nimport sys\\nfrom pathlib import Path\\nimport numpy as np\\nimport ml_dtypes\\n\\ndef decode(v):\\n    if isinstance(v, dict) and v.get('__sparse__'):\\n        a = np.zeros(v['shape'], dtype=v['values']['dtype'])\\n        if v['indices']:\\n            a[tuple(np.asarray(v['indices']).T)] = decode(v['values'])\\n        return a\\n    if isinstance(v, dict) and v.get('__ndarray__'):\\n        if 'imag' in v:\\n            a = np.empty(v['shape'], dtype=v['dtype'])\\n            a.real = v['values']\\n            a.imag = v['imag']\\n            return a\\n        return np.asarray(v['values'], dtype=v['dtype']).reshape(v['shape'])\\n    if isinstance(v, dict):\\n        return {k: decode(x) for k, x in v.items()}\\n    if isinstance(v, list):\\n        return [decode(x) for x in v]\\n    return v\\n\\ndef invoke_test(folder, role, index):\\n    import torch\\n    import tensorflow as tf\\n    folder = Path(folder)\\n    package = folder.parents[1]\\n    meta = json.loads((folder / 'case.json').read_text(encoding='utf-8'))\\n    item = json.loads((folder / 'inputs.json').read_text(encoding='utf-8'))[index]\\n    config = json.loads((package / 'protocol.json').read_text(encoding='utf-8'))\\n    root = Path(config['workspace_root'])\\n    sys.path.insert(0, str(root / '.codex-experiments/ivy-real-test'))\\n    from ivy_tests.test_ivy.helpers.assertions import value_test\\n    fw = meta[role + '_framework']\\n\\n    def convert(v):\\n        if isinstance(v, np.ndarray):\\n            if fw == 'torch':\\n                if str(v.dtype) == 'bfloat16':\\n                    return torch.tensor(v.astype(np.float32), dtype=torch.bfloat16)\\n                return torch.tensor(v.copy())\\n            return tf.constant(v.copy())\\n        if isinstance(v, dict):\\n            return {k: convert(x) for k, x in v.items()}\\n        if is